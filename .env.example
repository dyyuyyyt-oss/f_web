# AI Chat Backend - 环境变量示例
# 复制为 .env 并填入真实值；生产环境（如 Render）直接在平台的环境变量里配置，不需要 .env 文件

# ==================== 基础配置 ====================
DEBUG=false

# ==================== 数据库配置 ====================
# 本地开发用 SQLite；生产环境（如 Render）用 Postgres 的 DATABASE_URL 覆盖
DATABASE_URL=sqlite:///./ai_chat.db

# ==================== AI 提供商配置 ====================
# 当前选中的对话模型提供商：deepseek 或 volcengine
AI_PROVIDER=volcengine

# 是否使用模拟 AI 流（true 时不调用真实 API，方便本地开发不消耗额度）
USE_MOCK_AI=false

# -------- DeepSeek 配置 --------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# -------- 火山引擎方舟（对话模型）配置 --------
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=ep-20260907105823-l9xn6

# -------- 豆包（图片理解）配置，通过火山引擎方舟调用 --------
# 可以和 VOLCENGINE_API_KEY 填同一个值
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-20260921143106-x92h9
# 图片描述单次请求超时时间（秒），默认 60
IMAGE_DESCRIBE_TIMEOUT=60

# ==================== 对话模型参数 ====================
# 默认值偏高，是为了让角色扮演的回复更有多样性、更少重复用语
CHAT_TEMPERATURE=0.9
CHAT_TOP_P=0.95
CHAT_MAX_TOKENS=1024
CHAT_FREQUENCY_PENALTY=0.3
CHAT_PRESENCE_PENALTY=0.3

# ==================== 群聊 ====================
# 一个群最多几个角色（建群 / 改成员时校验；前端按它限制能勾选的数量）
GROUP_MAX_MEMBERS=3
# 一轮默认最多几个角色发言：一轮 = 这么多次串行的模型调用，调大会更慢、更费额度
GROUP_MAX_SPEAKERS=3
# 群聊 SSE 超过这么多秒没有数据就发一次心跳，防止连接被代理当成空闲断开
GROUP_HEARTBEAT_SECONDS=15

# ==================== 认证配置 ====================
# 用于签发/校验登录 JWT，生产环境必须设置为一个随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ==================== 预置账号 ====================
# 启动时账号不存在才会用这里的密码创建（已存在则跳过）；不填就不创建
# 普通用户 confur 的初始密码
PRESET_USER_PASSWORD=
# 管理员 con 的初始密码
PRESET_ADMIN_PASSWORD=

# ==================== CORS 配置 ====================
# JSON 数组字符串，列出允许访问后端的前端域名
CORS_ORIGINS=["http://localhost:5173"]
