# AI Chat Backend MVP - 环境配置示例
# 复制此文件为 .env，并填入你的实际配置

# ==================== 基础配置 ====================
DEBUG=false

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径
DATABASE_URL=sqlite:///./ai_chat.db

# ==================== AI 提供商配置 ====================
# 当前选中的 AI 提供商: deepseek 或 volcengine
AI_PROVIDER=deepseek

# 是否使用模拟 AI 流（不调用真实 API）
# 设为 true 时，聊天接口返回模拟文本，不消耗 API 额度
USE_MOCK_AI=true

# ==================== DeepSeek 配置 ====================
# 获取 API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== 火山引擎方舟（Volcano Engine Ark）配置 ====================
# 获取 API Key: https://console.volcengine.com/ark
# 推理接入点 ID 格式: ep-xxxxxxxxxxxxxxxx
VOLCENGINE_API_KEY=your-ark-api-key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=your-endpoint-id

# ==================== CORS 配置 ====================
# 允许的源（逗号分隔）
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ==================== API 配置 ====================
API_PREFIX=/api

# ==================== 流式响应缓冲 ====================
# 单位：字符数。当缓冲区达到此大小、或包含句末标点时，会一次性发送一个 SSE 事件
STREAM_BUFFER_SIZE=10
